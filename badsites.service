[Unit]
Description=GP Traffic Generator - badsites
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
#User=lab-user  # Replace with your username
WorkingDirectory=/home/lab-user/scripts/sase-traffic-generators/
ExecStartPre=/bin/bash -c 'while [ ! -s /home/lab-user/scripts/sase-traffic-generators/valid_gateway.txt ]; do sleep 5; done'
ExecStartPre=/bin/bash -c 'GATEWAY=$(cat /home/lab-user/scripts/sase-traffic-generators/valid_gateway.txt) && echo "Using Gateway: $GATEWAY"'
ExecStart=/bin/bash -c '/usr/bin/python3 gp-traffic-gen.py --domains badsites.txt --insecure --gateway $(cat /home/lab-user/scripts/sase-traffic-generators/valid_gateway.txt)'
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=120
StartLimitBurst=5

MemoryAccounting=yes
MemoryMax=256M
MemorySwapMax=0
TasksMax=16
LimitNOFILE=512
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target

